# GoRush Driver Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection
# Replace <db_password> with your actual MongoDB Atlas cluster password
MONGODB_URI=mongodb+srv://ira_09:<db_password>@cluster0.6pfn8y0.mongodb.net/driver_db?retryWrites=true&w=majority&appName=Cluster0
DB_NAME=driver_db

# JWT Configuration
JWT_SECRET=gorush_driver_jwt_secret_key_2026_change_in_prod
JWT_REFRESH_SECRET=gorush_driver_refresh_secret_key_2026
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS Configuration
CORS_ORIGIN=*

# Razorpay Payment Gateway Configuration
# Key ID can be shared with client app; Key Secret MUST NEVER be exposed to Flutter client
RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere
